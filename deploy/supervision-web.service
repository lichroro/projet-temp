[Unit]
Description=Interface web de supervision COGIP (Flask)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/pi/supervision/app.py
WorkingDirectory=/home/pi/supervision
Environment=SUPERVISION_USER=chef
Environment=SUPERVISION_PASSWORD=A_DEFINIR
Restart=always
RestartSec=5
User=pi

[Install]
WantedBy=multi-user.target
